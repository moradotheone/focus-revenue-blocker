{
  "manifest_version": 3,
  "name": "FocusRevenue — Bloqueador por Meta de Facturación",
  "version": "0.1.0",
  "description": "Bloquea distracciones hasta que alcances tu meta diaria de facturación en Stripe o PayPal. Diseñado para emprendedores y creadores.",
  "homepage_url": "https://moradotheone.github.io/focus-revenue-blocker/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "FocusRevenue // Telemetry HUD"
  },
  "options_ui": {
    "page": "src/dashboard/dashboard.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://api.stripe.com/*",
    "https://api-m.paypal.com/*",
    "https://api.sandbox.paypal.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "*://*.reddit.com/*",
    "*://*.tiktok.com/*",
    "*://*.facebook.com/*",
    "*://*.twitch.tv/*",
    "*://*.linkedin.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/blocked/blocked.html",
        "src/blocked/blocked.css",
        "src/blocked/blocked.js",
        "src/lib/storage.js",
        "src/lib/billing.js",
        "src/lib/rules.js",
        "src/lib/payments.js",
        "src/lib/monetization.js",
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
