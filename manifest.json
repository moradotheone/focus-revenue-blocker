{
  "manifest_version": 3,
  "name": "FocusRevenue — Bloqueador de Distracciones por Meta de Facturación",
  "version": "0.1.0",
  "description": "Bloquea sitios web de distracción hasta que alcances tu meta diaria de facturación. Diseñado para emprendedores independientes.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "FocusRevenue"
  },
  "options_ui": {
    "page": "src/dashboard/dashboard.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/blocked/blocked.html",
        "src/blocked/blocked.css",
        "src/blocked/blocked.js",
        "src/lib/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
